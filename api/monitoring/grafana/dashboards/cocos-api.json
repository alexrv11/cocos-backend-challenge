{
  "dashboard": {
    "id": null,
    "uid": "cocos-api",
    "title": "Cocos Trading API",
    "tags": ["cocos", "api"],
    "timezone": "browser",
    "refresh": "10s",
    "time": { "from": "now-30m", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Request Rate (req/s)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[1m])) by (route)",
            "legendFormat": "{{route}}"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "reqps" }
        }
      },
      {
        "id": 2,
        "title": "Latency p95 (seconds)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, route))",
            "legendFormat": "p95 {{route}}"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, route))",
            "legendFormat": "p99 {{route}}"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "s" }
        }
      },
      {
        "id": 3,
        "title": "Error Rate (4xx + 5xx)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{status=~\"4..|5..\"}[1m])) by (status)",
            "legendFormat": "{{status}}"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "reqps" }
        }
      },
      {
        "id": 4,
        "title": "Orders Created by Status",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "sum(rate(orders_created_total[1m])) by (status)",
            "legendFormat": "{{status}}"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "reqps" }
        }
      },
      {
        "id": 5,
        "title": "Auth: Login Attempts",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "sum(auth_login_total{result=\"success\"}) or vector(0)",
            "legendFormat": "Success"
          },
          {
            "expr": "sum(auth_login_total{result=\"failure\"}) or vector(0)",
            "legendFormat": "Failure"
          }
        ]
      },
      {
        "id": 6,
        "title": "Auth: Register Attempts",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
        "targets": [
          {
            "expr": "sum(auth_register_total{result=\"success\"}) or vector(0)",
            "legendFormat": "Success"
          },
          {
            "expr": "sum(auth_register_total{result=\"failure\"}) or vector(0)",
            "legendFormat": "Failure"
          }
        ]
      },
      {
        "id": 7,
        "title": "Orders Cancelled",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "sum(orders_cancelled_total) or vector(0)",
            "legendFormat": "Total"
          }
        ]
      },
      {
        "id": 8,
        "title": "Process Memory (RSS)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
        "targets": [
          {
            "expr": "process_resident_memory_bytes{job=\"cocos-api\"}",
            "legendFormat": "RSS"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "bytes" }
        }
      },
      {
        "id": 9,
        "title": "CPU Usage",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
        "targets": [
          {
            "expr": "rate(process_cpu_seconds_total{job=\"cocos-api\"}[1m])",
            "legendFormat": "CPU"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "percentunit" }
        }
      }
    ],
    "schemaVersion": 39
  },
  "overwrite": true
}
