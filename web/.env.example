# API base URL (defaults to /api which is proxied by Vite in dev)
VITE_API_URL=/api

# Set to "false" to bypass MSW mocks and hit the real API in dev mode
VITE_MOCK_API=true

# Vite dev proxy target for /api requests (used in vite.config.ts)
# Default: http://localhost:3000 (Docker Compose)
# K8s:     http://localhost:8080  (kind cluster via NodePort)
VITE_API_PROXY_TARGET=http://localhost:3000
